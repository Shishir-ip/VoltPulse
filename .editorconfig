root = true

[*]
charset = utf-8
insert_final_newline = true
indent_style = space
indent_size = 4

[*.{csproj,props,targets,xml,xaml,json,yml,yaml}]
indent_size = 2

[*.cs]
csharp_style_namespace_declarations = file_scoped:suggestion

# CA1000: Sourced<T>.Unknown / From(...) is the idiomatic Option-style pattern for this model.
dotnet_diagnostic.CA1000.severity = none

# xUnit naming convention uses underscores in test method names.
[tests/**/*.cs]
dotnet_diagnostic.CA1707.severity = none
