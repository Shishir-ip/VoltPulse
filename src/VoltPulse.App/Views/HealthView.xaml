<UserControl x:Class="VoltPulse.App.Views.HealthView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:VoltPulse.App.Controls"
             xmlns:conv="clr-namespace:VoltPulse.App.Converters">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:InverseBoolConverter x:Key="InverseBool" />
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="26,18,26,18">
        <StackPanel MaxWidth="860" HorizontalAlignment="Stretch">
            <TextBlock Text="Health" Style="{StaticResource H1}" />

            <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Health ring -->
                <Border Grid.Column="0" Style="{StaticResource CardBody}" Padding="18">
                    <StackPanel HorizontalAlignment="Center">
                        <Grid Width="150" Height="150" HorizontalAlignment="Center">
                            <Ellipse Stroke="{DynamicResource BrushPillTrack}" StrokeThickness="12" />
                            <Ellipse x:Name="HealthRing"
                                     Stroke="{DynamicResource BrushAccent}"
                                     StrokeThickness="12"
                                     StrokeDashArray="1 0"
                                     StrokeDashCap="Round"
                                     RenderTransformOrigin="0.5,0.5">
                                <Ellipse.LayoutTransform>
                                    <RotateTransform Angle="-90" />
                                </Ellipse.LayoutTransform>
                            </Ellipse>
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock x:Name="HealthValue" Text="{Binding HealthText}" FontSize="30" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                <TextBlock Text="health" Style="{StaticResource Caption}" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                        <TextBlock x:Name="VerdictText" Text="{Binding Verdict}" FontSize="19" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,0" />
                    </StackPanel>
                </Border>

                <!-- Details card -->
                <Border Grid.Column="1" Style="{StaticResource CardBody}" Margin="14,0,0,0">
                    <StackPanel>
                        <TextBlock Text="Capacity" Style="{StaticResource H2}" />
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Full-charge" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                            <ProgressBar Grid.Column="1" x:Name="HealthBar" Height="12" Minimum="0" Maximum="1"
                                         Value="{Binding BarHealthWidth}" Foreground="{DynamicResource BrushAccent}" />
                            <TextBlock Grid.Row="1" Text="Design" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,8,0,0" />
                            <ProgressBar Grid.Row="1" Grid.Column="1" Height="12" Minimum="0" Maximum="1" Value="1"
                                         Foreground="{DynamicResource BrushPillTrack}" Margin="0,8,0,0" />
                        </Grid>
                        <TextBlock Text="{Binding VerdictDetail}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,12,0,0" />

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Wear level" Style="{StaticResource Caption}" />
                                <TextBlock Text="{Binding WearText}" Style="{StaticResource StatValue}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Cycle count" Style="{StaticResource Caption}" />
                                <TextBlock Text="{Binding CycleCountText}" Style="{StaticResource StatValue}" FontSize="14" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Design capacity" Style="{StaticResource Caption}" />
                                <TextBlock Text="{Binding DesignCapacityText}" Style="{StaticResource StatValue}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Full-charge capacity" Style="{StaticResource Caption}" />
                                <TextBlock Text="{Binding FullChargeCapacityText}" Style="{StaticResource StatValue}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Long-term fade -->
            <Border Style="{StaticResource CardBody}" Padding="12" Margin="0,14,0,0">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="Long-term capacity fade" Style="{StaticResource H2}" VerticalAlignment="Center" />
                        <Button Style="{StaticResource AppButton}" HorizontalAlignment="Right"
                                Command="{Binding ImportReportCommand}"
                                IsEnabled="{Binding IsImporting, Converter={StaticResource InverseBool}}"
                                Content="Import Windows battery report"
                                AutomationProperties.Name="Import Windows battery report" />
                    </Grid>
                    <controls:TimeSeriesChart x:Name="FadeChart" Height="240" Margin="0,10,0,0" />
                    <TextBlock Text="{Binding FadeSource}" Style="{StaticResource Caption}" Margin="4,6,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
