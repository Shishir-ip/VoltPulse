<UserControl x:Class="VoltPulse.App.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="26,18,26,18">
        <StackPanel MaxWidth="820" HorizontalAlignment="Stretch">
            <TextBlock Text="Reports" Style="{StaticResource H1}" />
            <TextBlock Text="{Binding Status}" Style="{StaticResource Caption}" Margin="0,8,0,14" TextWrapping="Wrap" />

            <Border Style="{StaticResource CardBody}">
                <StackPanel>
                    <TextBlock Text="Export history" Style="{StaticResource H2}" />
                    <TextBlock Style="{StaticResource Caption}" Text="Full-resolution samples from the retention window, as configured in Settings." Margin="0,4,0,10" />
                    <WrapPanel>
                        <Button Style="{StaticResource AppButton}" Content="Export CSV" Command="{Binding ExportCsvCommand}" />
                        <Button Style="{StaticResource AppButton}" Content="Export JSON" Command="{Binding ExportJsonCommand}" Margin="8,0,0,0" />
                        <Button Style="{StaticResource AppButton}" Content="Export HTML report" Command="{Binding ExportHtmlCommand}" Margin="8,0,0,0" />
                        <Button Style="{StaticResource AppButton}" Content="Export PDF report" Command="{Binding ExportPdfCommand}" Margin="8,0,0,0" />
                        <Button Style="{StaticResource AppButton}" Content="Open exports folder" Command="{Binding OpenExportsFolderCommand}" Margin="8,0,0,0" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBody}" Margin="0,14,0,0">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="Windows battery report (powercfg)" Style="{StaticResource H2}" VerticalAlignment="Center" />
                        <Button Style="{StaticResource AppButton}" HorizontalAlignment="Right" Content="Import" Command="{Binding ImportPowerCfgReportCommand}" />
                    </Grid>
                    <TextBlock Text="{Binding PowerCfgSummary}" Style="{StaticResource Caption}" Margin="0,8,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
