<UserControl x:Class="VoltPulse.App.Views.SessionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:VoltPulse.App.Controls">
    <Grid Margin="26,18,26,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <TextBlock Text="Sessions" Style="{StaticResource H1}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource AppButton}" Content="Refresh" Command="{Binding RefreshCommand}" />
                <Button Style="{StaticResource AppButton}" Content="Clear history" Command="{Binding ClearHistoryCommand}" Margin="8,0,0,0" />
            </StackPanel>
        </Grid>

        <TextBlock Grid.Row="1" Text="{Binding Summary}" Style="{StaticResource Caption}" Margin="0,8,0,10" TextWrapping="Wrap" />

        <Border Grid.Row="2" Style="{StaticResource CardBody}" Padding="6">
            <ListView ItemsSource="{Binding Sessions}"
                      SelectedItem="{Binding SelectedSession}"
                      x:Name="SessionsList"
                      AutomationProperties.Name="Battery sessions"
                      Background="Transparent"
                      BorderThickness="0">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Type" DisplayMemberBinding="{Binding Kind}" Width="110" />
                        <GridViewColumn Header="Started" DisplayMemberBinding="{Binding Start}" Width="150" />
                        <GridViewColumn Header="Duration" DisplayMemberBinding="{Binding Duration}" Width="110" />
                        <GridViewColumn Header="Charge level" DisplayMemberBinding="{Binding PercentChange}" Width="170" />
                        <GridViewColumn Header="Average current" DisplayMemberBinding="{Binding AverageCurrent}" Width="140" />
                        <GridViewColumn Header="Peak current" DisplayMemberBinding="{Binding PeakCurrent}" Width="140" />
                        <GridViewColumn Header="Energy" DisplayMemberBinding="{Binding Energy}" Width="120" />
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource CardBody}" Padding="10" Margin="0,12,0,0" Height="220">
            <controls:TimeSeriesChart x:Name="SessionChart" />
        </Border>
    </Grid>
</UserControl>
