<UserControl x:Class="VoltPulse.App.Views.LiveView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:VoltPulse.App.Behaviors"
             xmlns:conv="clr-namespace:VoltPulse.App.Converters">
    <UserControl.Resources>
        <conv:BrushKeyToBrushConverter x:Key="KeyToBrush" />
        <conv:FractionToWidthConverter x:Key="FractionToWidth" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top bar -->
        <Grid Grid.Row="0" Margin="26,18,26,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Path Data="{StaticResource IconBolt}"
                      Width="18" Height="18" Stretch="Uniform"
                      Fill="{DynamicResource BrushAccent}" />
                <TextBlock Text="VoltPulse" Style="{StaticResource H2}" Margin="9,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource IconButton}"
                        x:Name="ShareButton"
                        Click="OnShareClick"
                        ToolTip="Save a snapshot image and copy a text summary"
                        AutomationProperties.Name="Share snapshot">
                    <Path Data="{StaticResource IconShare}" Width="17" Height="17" Stretch="Uniform"
                          Stroke="{DynamicResource BrushTextPrimary}" StrokeThickness="1.7"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                </Button>
                <Button Style="{StaticResource IconButton}"
                        Command="{Binding DataContext.NavigateToCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="Settings"
                        ToolTip="Settings"
                        AutomationProperties.Name="Settings">
                    <Path Data="{StaticResource IconGear}" Width="17" Height="17" Stretch="Uniform"
                          Stroke="{DynamicResource BrushTextPrimary}" StrokeThickness="1.7"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- Pills -->
        <ItemsControl Grid.Row="1"
                      ItemsSource="{Binding Pills}"
                      HorizontalAlignment="Center"
                      Margin="0,22,0,0">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Grid Width="56" Height="10" Margin="4,0">
                        <Border Background="{DynamicResource BrushPillTrack}" CornerRadius="5" />
                        <Border HorizontalAlignment="Left"
                                CornerRadius="5"
                                Width="{Binding Fill, Converter={StaticResource FractionToWidth}, ConverterParameter=56}"
                                Background="{Binding DataContext.LiveBrushKey, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource KeyToBrush}}" />
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Big reading -->
        <StackPanel Grid.Row="2" HorizontalAlignment="Center" Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="{Binding BigValue}"
                           Style="{StaticResource BigReading}"
                           Foreground="{Binding LiveBrushKey, Converter={StaticResource KeyToBrush}}"
                           Visibility="{Binding BigValueVisible, Converter={StaticResource BoolToVis}}" />
                <TextBlock Text="{Binding BigUnit}"
                           Style="{StaticResource BigUnit}"
                           Margin="7,0,0,16"
                           VerticalAlignment="Bottom"
                           Visibility="{Binding BigValueVisible, Converter={StaticResource BoolToVis}}" />
            </StackPanel>
            <TextBlock Text="{Binding MeasuringText}"
                       Style="{StaticResource Caption}"
                       FontSize="14"
                       HorizontalAlignment="Center"
                       Margin="0,4,0,0"
                       Visibility="{Binding Measuring, Converter={StaticResource BoolToVis}}" />
        </StackPanel>

        <!-- Min / reset / max -->
        <Grid Grid.Row="3" Width="660" HorizontalAlignment="Center" Margin="0,16,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" HorizontalAlignment="Left" Margin="28,0,0,0">
                <TextBlock Text="MIN" Style="{StaticResource Caption}" />
                <TextBlock Text="{Binding MinText}" Style="{StaticResource StatValue}" Margin="0,2,0,0" />
            </StackPanel>
            <Button Grid.Column="1"
                    Style="{StaticResource RoundButton}"
                    Width="46" Height="46"
                    Command="{Binding ResetMinMaxCommand}"
                    ToolTip="Reset session min/max"
                    AutomationProperties.Name="Reset minimum and maximum">
                <Path Data="{StaticResource IconClose}" Width="15" Height="15" Stretch="Uniform"
                      Stroke="{DynamicResource BrushTextPrimary}" StrokeThickness="1.8"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
            </Button>
            <StackPanel Grid.Column="2" HorizontalAlignment="Right" Margin="0,0,28,0">
                <TextBlock Text="MAX" Style="{StaticResource Caption}" />
                <TextBlock Text="{Binding MaxText}" Style="{StaticResource StatValue}" Margin="0,2,0,0" />
            </StackPanel>
        </Grid>

        <!-- Facts -->
        <ScrollViewer Grid.Row="4"
                      VerticalScrollBarVisibility="Auto"
                      Padding="26,10,26,18"
                      Margin="0,8,0,0">
            <StackPanel MaxWidth="780" HorizontalAlignment="Center">
                <Border Style="{StaticResource OnboardingChip}"
                        Margin="0,0,0,14"
                        Visibility="{Binding OnboardingVisible, Converter={StaticResource BoolToVis}}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right"
                                Style="{StaticResource IconButton}"
                                Command="{Binding DismissOnboardingCommand}"
                                AutomationProperties.Name="Dismiss tip"
                                VerticalAlignment="Center">
                            <Path Data="{StaticResource IconClose}" Width="11" Height="11" Stretch="Uniform"
                                  Stroke="{DynamicResource BrushTextPrimary}" StrokeThickness="1.8"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        </Button>
                        <TextBlock Text="{Binding OnboardingText}"
                                   TextWrapping="Wrap"
                                   FontSize="13"
                                   MaxWidth="600"
                                   VerticalAlignment="Center" />
                    </DockPanel>
                </Border>

                <Border Style="{StaticResource CardBody}" Padding="10,8">
                    <ItemsControl ItemsSource="{Binding Facts}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource FactRowBorder}"
                                        behaviors:ClickToCopy.Enable="True"
                                        behaviors:ClickToCopy.Text="{Binding CopyValue}"
                                        ToolTip="{Binding ToolTip}"
                                        AutomationProperties.Name="{Binding Label}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Label}"
                                                   FontSize="13.5"
                                                   Foreground="{DynamicResource BrushTextSecondary}" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Value}"
                                                   FontSize="14"
                                                   TextAlignment="Right" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Floating action button -->
        <Button Grid.Row="4"
                Style="{StaticResource RoundButton}"
                Width="54" Height="54"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                Margin="26,0,0,24"
                AutomationProperties.Name="Quick actions"
                ToolTip="Quick actions">
            <Button.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="{Binding PauseMenuText}" Command="{Binding TogglePauseCommand}" />
                    <MenuItem Header="{Binding PlugMenuText}"
                              Command="{Binding TogglePlugCommand}"
                              Visibility="{Binding HasMock, Converter={StaticResource BoolToVis}}" />
                    <MenuItem Header="{Binding DemoMenuText}" Command="{Binding ToggleDemoCommand}" />
                    <Separator />
                    <MenuItem Header="Mini widget" Command="{Binding ToggleMiniWidgetCommand}" />
                </ContextMenu>
            </Button.ContextMenu>
            <StackPanel>
                <Path Data="{StaticResource IconBatteryBody}" Width="26" Height="13" Stretch="Uniform"
                      Stroke="{DynamicResource BrushTextPrimary}" StrokeThickness="1.6"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                <Path Data="{StaticResource IconBatteryBolt}" Width="12" Height="12" Stretch="Uniform"
                      Fill="{DynamicResource BrushAccent}" Margin="0,-11,0,0" HorizontalAlignment="Center" />
            </StackPanel>
        </Button>
    </Grid>
</UserControl>
