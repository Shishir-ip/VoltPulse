<UserControl x:Class="VoltPulse.App.Views.InsightsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="26,18,26,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <TextBlock Text="Insights" Style="{StaticResource H1}" />
            <Button Style="{StaticResource AppButton}" HorizontalAlignment="Right" Content="Refresh" Command="{Binding RefreshCommand}" />
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource CardBody}" Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal">
                <StackPanel HorizontalAlignment="Left" Margin="0,0,30,0">
                    <TextBlock Text="Habit score" Style="{StaticResource Caption}" />
                    <TextBlock Text="{Binding ScoreText}" FontSize="42" FontWeight="SemiBold" Foreground="{DynamicResource BrushAccent}" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Last 7 days" Style="{StaticResource Caption}" Margin="0,0,0,6" />
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                        <TextBlock Text="Charged all the way to 100%" Style="{StaticResource Caption}" />
                        <TextBlock Grid.Column="1" Text="{Binding ChargeToFullText}" Margin="16,0,0,0" />
                        <TextBlock Grid.Row="1" Text="Time spent at 100%" Style="{StaticResource Caption}" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding TimeAtFullText}" Margin="16,0,0,0" />
                        <TextBlock Grid.Row="2" Text="Deep discharges (below 20%)" Style="{StaticResource Caption}" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding DeepDischargeText}" Margin="16,0,0,0" />
                        <TextBlock Grid.Row="3" Text="Average discharge depth" Style="{StaticResource Caption}" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding AvgDepthText}" Margin="16,0,0,0" />
                    </Grid>
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource CardBody}" Margin="0,14,0,0" MaxWidth="820" HorizontalAlignment="Stretch">
            <StackPanel>
                <TextBlock Text="Tips" Style="{StaticResource H2}" />
                <ItemsControl ItemsSource="{Binding Tips}" Margin="0,6,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="0,3">
                                <TextBlock Text="•" Foreground="{DynamicResource BrushAccent}" FontWeight="Bold" VerticalAlignment="Top" />
                                <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="8,0,0,0" MaxWidth="680" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
