<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="ColorBg">#121212</Color>
    <Color x:Key="ColorSurface">#181818</Color>
    <Color x:Key="ColorCard">#1E1E1E</Color>
    <Color x:Key="ColorCardBorder">#2A2A2A</Color>
    <Color x:Key="ColorHeader">#263238</Color>
    <Color x:Key="ColorTextPrimary">#ECECEC</Color>
    <Color x:Key="ColorTextSecondary">#9E9E9E</Color>
    <Color x:Key="ColorButtonBg">#2A2A2A</Color>
    <Color x:Key="ColorButtonHover">#353535</Color>
    <Color x:Key="ColorNavHover">#232D33</Color>
    <Color x:Key="ColorNavActive">#37474F</Color>
    <Color x:Key="ColorPillTrack">#2E2E2E</Color>
    <Color x:Key="ColorAccent">#00BFA5</Color>

    <SolidColorBrush x:Key="BrushBg" Color="{StaticResource ColorBg}" />
    <SolidColorBrush x:Key="BrushSurface" Color="{StaticResource ColorSurface}" />
    <SolidColorBrush x:Key="BrushCard" Color="{StaticResource ColorCard}" />
    <SolidColorBrush x:Key="BrushCardBorder" Color="{StaticResource ColorCardBorder}" />
    <SolidColorBrush x:Key="BrushHeader" Color="{StaticResource ColorHeader}" />
    <SolidColorBrush x:Key="BrushTextPrimary" Color="{StaticResource ColorTextPrimary}" />
    <SolidColorBrush x:Key="BrushTextSecondary" Color="{StaticResource ColorTextSecondary}" />
    <SolidColorBrush x:Key="BrushButtonBg" Color="{StaticResource ColorButtonBg}" />
    <SolidColorBrush x:Key="BrushButtonHover" Color="{StaticResource ColorButtonHover}" />
    <SolidColorBrush x:Key="BrushNavHover" Color="{StaticResource ColorNavHover}" />
    <SolidColorBrush x:Key="BrushNavActive" Color="{StaticResource ColorNavActive}" />
    <SolidColorBrush x:Key="BrushPillTrack" Color="{StaticResource ColorPillTrack}" />
    <SolidColorBrush x:Key="BrushAccent" Color="{StaticResource ColorAccent}" />

    <SolidColorBrush x:Key="BrushStateDischarging" Color="#FF9100" />
    <SolidColorBrush x:Key="BrushStateCharging" Color="#00BFA5" />
    <SolidColorBrush x:Key="BrushStateFull" Color="#66BB6A" />
    <SolidColorBrush x:Key="BrushStateCritical" Color="#FF5252" />
    <SolidColorBrush x:Key="BrushStateUnknown" Color="#9E9E9E" />
</ResourceDictionary>
