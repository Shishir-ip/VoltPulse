<UserControl x:Class="VoltPulse.App.Controls.TimeSeriesChart"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sp="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF">
    <Grid>
        <sp:WpfPlot x:Name="Plot" />
        <TextBlock x:Name="EmptyHint"
                   Text="Collecting data..."
                   Foreground="{DynamicResource BrushTextSecondary}"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Visibility="Collapsed" />
    </Grid>
</UserControl>
